{
  "frame_selector": {
    "selector_type": "fps_rescaling",
    "fps": 0.5
  },
  "frame_extractor": {
    "resolution": [
      640,
      360
    ],
    "max_batch_size": 1
  },
  "llm": {
    "backend": "moondream_cloud",
    "model": "moondream-3",
    "url": "https://api.moondream.ai/v1/",
    "api_key": "${WCT_MOONDREAM_API_KEY}"
  },
  "query": {
    "query_type": "llm",
    "prompt": "This is a video image from a UK garden near a river. Is there an animal in this image, if so what?",
    "response_schema": "SpeciesResult"
  },
  "reconciler": {
    "reconciler_type": "majority"
  }
}
